{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bwa-unfinished-archive-v2",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "routes": [
    { "pattern": "api-doodle.bloodweavearchive.com", "custom_domain": true }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARDS",
        "class_name": "BoardRoom"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "PUBLIC_SNAPSHOTS",
      "bucket_name": "bwa-doodle-public-snapshots",
      "preview_bucket_name": "bwa-doodle-public-snapshots-preview"
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ],
  "triggers": {
    "crons": ["30 19 * * *"]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "BOARD_MAX_ITEMS": "300000",
    "PUBLIC_SNAPSHOT_INTERVAL_SECONDS": "600",
    "BACKUP_BOARD_IDS": "bwa-unfinished-archive",
    "GOOGLE_DRIVE_FOLDER_ID": "1jz_Li-2T8MivoZ7KECHccNdKYzY9KrQ9",
    "SOURCE_REPOSITORY": "natsumi723-byte/bloodweavearchive-doodle",
    "ACCESS_TEAM_DOMAIN": "https://steep-disk-9622.cloudflareaccess.com",
    "ACCESS_POLICY_AUD": "b3a665a19257235ed1fee89af1b7a8f1c840b75ba4a0792c5b791fad5b5277a6",
    "ALLOWED_PUBLIC_ORIGINS": "https://doodle.bloodweavearchive.com",
    "ALLOWED_ADMIN_ORIGINS": "https://admin-doodle.bloodweavearchive.com"
  },
  "observability": {
    "enabled": true
  }
}
