	"type": "module",
	"license": "AGPL-3.0-or-later",
	"scripts": {
		"dev": "wrangler dev",
		"check": "node --check src/index.js && node --test test/*.test.js",
		"test": "node --test test/*.test.js",
		"check:backup-integration": "node scripts/backup-integration-check.mjs",
