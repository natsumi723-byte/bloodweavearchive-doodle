{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bwa-doodle-site",
  "main": "src/index.js",
  "compatibility_date": "2026-10-23",
  "workers_dev": false,
  "routes": [
    { "pattern": "doodle.bloodweavearchive.com", "custom_domain": true },
    { "pattern": "admin-doodle.bloodweavearchive.com", "custom_domain": true }
  ],
  "services": [
    {
      "binding": "API",
      "service": "bwa-unfinished-archive-v2"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/boards",
      "/boards/*",
      "/admin",
      "/admin/*",
      "/manifest.json",
      "/api/*",
      "/public-*.html",
      "/admin-*.html",
      "/manifest-*.json"
    ],
    "html_handling": "none"
  },
  "vars": {
    "BOARD_ID": "bwa-unfinished-archive",
    "PUBLIC_HOST": "doodle.bloodweavearchive.com",
    "ADMIN_HOST": "admin-doodle.bloodweavearchive.com"
  },
  "observability": {
    "enabled": true
  }
}
